# Sempre buscar a versão mais nova do app (dados do motorista ficam no celular, não aqui)
<IfModule mod_headers.c>
  <FilesMatch "\.(html|json|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Manual e fontes de vídeo: só no GitHub, não no site
<FilesMatch "\.(md|py|wav|mp3|webm)$">
  Require all denied
</FilesMatch>
